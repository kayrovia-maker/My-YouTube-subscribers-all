<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Subscribe to My YouTube Channel</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #111827, #1f2937);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 900px;
    }

    .card {
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 24px;
      padding: 45px;
      text-align: center;
      box-shadow: 0 25px 70px rgba(0,0,0,0.35);
    }

    .youtube-icon {
      width: 80px;
      height: 56px;
      background: #ff0000;
      border-radius: 16px;
      margin: 0 auto 25px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .youtube-icon::after {
      content: "";
      width: 0;
      height: 0;
      border-top: 10px solid transparent;
      border-bottom: 10px solid transparent;
      border-left: 16px solid white;
      margin-left: 4px;
    }

    h1 {
      font-size: 38px;
      margin-bottom: 12px;
    }

    .subtitle {
      color: #d1d5db;
      font-size: 17px;
      line-height: 1.6;
      margin-bottom: 35px;
    }

    .form {
      display: flex;
      gap: 12px;
      max-width: 650px;
      margin: auto;
    }

    input {
      flex: 1;
      padding: 16px;
      border-radius: 12px;
      border: none;
      outline: none;
      font-size: 16px;
    }

    button {
      padding: 16px 25px;
      border: none;
      border-radius: 12px;
      background: #ff0000;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s;
    }

    button:hover {
      transform: translateY(-2px);
      opacity: 0.9;
    }

    .message {
      display: none;
      margin-top: 20px;
      padding: 15px;
      border-radius: 10px;
      background: rgba(255,255,255,0.1);
      color: #d1d5db;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-top: 40px;
    }

    .stat {
      background: rgba(255,255,255,0.07);
      border-radius: 15px;
      padding: 20px;
    }

    .stat-number {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 5px;
    }

    .stat-label {
      color: #9ca3af;
      font-size: 14px;
    }

    .notice {
      margin-top: 30px;
      color: #9ca3af;
      font-size: 13px;
      line-height: 1.6;
    }

    .footer {
      margin-top: 25px;
      color: #6b7280;
      font-size: 13px;
    }

    @media (max-width: 650px) {

      .card {
        padding: 30px 20px;
      }

      h1 {
        font-size: 28px;
      }

      .form {
        flex-direction: column;
      }

      button {
        width: 100%;
      }

      .stats {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="card">

      <div class="youtube-icon"></div>

      <h1>Subscribe to My Channel</h1>

      <p class="subtitle">
        Enter your email below and we'll take you to the official
        YouTube subscription page.
      </p>

      <form class="form" id="subscribeForm">

        <input
          type="email"
          id="email"
          placeholder="Example@gmail.com"
          required
        >

        <button type="submit">
          Subscribe
        </button>

      </form>

      <div class="message" id="message">
        Opening YouTube...
      </div>

      <div class="stats">

        <div class="stat">
          <div class="stat-number" id="visitors">
            0
          </div>

          <div class="stat-label">
            Visitors
          </div>
        </div>

        <div class="stat">
          <div class="stat-number" id="clicks">
            0
          </div>

          <div class="stat-label">
            Subscribe Clicks
          </div>
        </div>

        <div class="stat">
          <div class="stat-number">
            ❤️
          </div>

          <div class="stat-label">
            Thank You!
          </div>
        </div>

      </div>

      <p class="notice">
        Your email is only used to provide the subscription experience.
        YouTube will handle the actual subscription through its official
        website.
      </p>

      <div class="footer">
        © 2026 Your Channel
      </div>

    </div>

  </div>


  <script>

    /*
      ============================================
      CHANGE THIS TO YOUR YOUTUBE CHANNEL URL
      ============================================
    */

   const CHANNEL_URL = "https://www.youtube.com/@kayrovia";


    /*
      ============================================
      VISITOR COUNTER
      ============================================
    */

    let visitors =
      Number(localStorage.getItem("visitors")) || 0;

    visitors++;

    localStorage.setItem(
      "visitors",
      visitors
    );

    document.getElementById("visitors")
      .textContent = visitors;


    /*
      ============================================
      SUBSCRIBE BUTTON
      ============================================
    */

    document
      .getElementById("subscribeForm")
      .addEventListener("submit", function(event) {

        event.preventDefault();

        const email =
          document.getElementById("email").value.trim();

        if (!email) {
          return;
        }

        /*
          Store the email locally.

          IMPORTANT:
          This does NOT subscribe the email address.
          The user must complete the subscription
          themselves on YouTube.
        */

        localStorage.setItem(
          "lastEmail",
          email
        );


        /*
          Count subscribe-button clicks.
        */

        let clicks =
          Number(localStorage.getItem("subscribeClicks")) || 0;

        clicks++;

        localStorage.setItem(
          "subscribeClicks",
          clicks
        );

        document.getElementById("clicks")
          .textContent = clicks;


        /*
          Show message.
        */

        const message =
          document.getElementById("message");

        message.style.display = "block";

        message.textContent =
          "Opening YouTube. Please complete the subscription there.";


        /*
          Open YouTube channel.
        */

        if (
          CHANNEL_URL === "YOUR_CHANNEL_URL" ||
          !CHANNEL_URL
        ) {

          alert(
            "Please replace YOUR_CHANNEL_URL in the code with your actual YouTube channel URL."
          );

          return;
        }


        window.open(
          CHANNEL_URL,
          "_blank"
        );

      });


    /*
      Restore click counter.
    */

    document.getElementById("clicks")
      .textContent =
      Number(
        localStorage.getItem("subscribeClicks")
      ) || 0;

  </script>

</body>
</html>